 namespace {
 
+// Wall-clock budget for one sqlite3_step() of an application (non-TRUSTED) statement, from
+// WORKERD_SQLITE_STATEMENT_TIMEOUT_MS. 0 (the default) disables the progress handler entirely.
+kj::Duration stepBudget() {
+  static const kj::Duration budget = []() {
+    const char* env = getenv("WORKERD_SQLITE_STATEMENT_TIMEOUT_MS");
+    return (env == nullptr ? 0 : strtoull(env, nullptr, 10)) * kj::MILLISECONDS;
+  }();
+  return budget;
+}
+
+// Deadline of the step running on this thread, if it is budgeted.
+thread_local kj::Maybe<kj::TimePoint> stepDeadline;
+
+struct StepDeadlineScope {
+  kj::Maybe<kj::TimePoint> saved = stepDeadline;
+  explicit StepDeadlineScope(bool budgeted) {
+    stepDeadline = kj::none;
+    if (budgeted && stepBudget() > 0 * kj::MILLISECONDS) {
+      stepDeadline = kj::systemPreciseMonotonicClock().now() + stepBudget();
+    }
+  }
+  ~StepDeadlineScope() {
+    stepDeadline = saved;
+  }
+  KJ_DISALLOW_COPY_AND_MOVE(StepDeadlineScope);
+};
+
 void disposeSqlite(sqlite3_stmt* stmt) {
   sqlite3_finalize(stmt);
 
