// Naru at the edge. Hosted sites, <login>.naru.pub, are served from the site
// bucket (see docs/deployment.md, "Hosted sites at the edge"), their routes
// rendered on the mini, where site databases live (docs/database.md). It also
// keeps the control plane's pageview log and custom domain table.
//
// Local runs (`wrangler dev --env local`: pnpm dev and the control plane's
// with-edge-worker.sh) also hold site databases themselves, as the mini
// does: see "env.local" at the end. naru-dev runs the mini's Worker instead
// (../naru-dev/scripts/build-worker.mjs).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "naru-edge",
  // The account that holds the naru.pub zone: a route or custom domain only
  // reaches a Worker in its zone's account.
  "account_id": "5d508a37b0c6ea183620094959bbc8d1",
  "main": "src/index.ts",
  // The control plane calls edge.naru.pub; expose no workers.dev URLs.
  "workers_dev": false,
  "preview_urls": false,
  "compatibility_date": "2026-10-01",
  // Buffer and node:crypto, for the control plane's cursor and filter code.
  "compatibility_flags": ["nodejs_compat"],
  // Control-plane modules the Worker imports find their packages here, since
  // Workers Builds installs only this directory's.
  "alias": { "acorn": "./node_modules/acorn/dist/acorn.mjs" },
  "durable_objects": {
    "bindings": [
      // One log of every edge-served pageview, drained by the control plane.
      { "name": "PAGEVIEWS", "class_name": "PageviewLog" },
      // What reaches the mini, where site databases live, and its health
      // check (src/standby.ts). Named for the read-only standby it once was.
      { "name": "STANDBY", "class_name": "Standby" },
    ],
  },
  // The classes' namespaces. SiteData and PageviewLog moved here, with their
  // data, from the Worker's former name, naru-site-data. SiteData's objects,
  // the read-only standby's copies of site databases, are deleted: site
  // databases live only on the mini (wrangler.seoul.jsonc).
  "exports": {
    "SiteData": { "type": "durable-object", "state": "deleted" },
    "PageviewLog": { "type": "durable-object", "storage": "sqlite" },
    "Standby": { "type": "durable-object", "storage": "sqlite" },
  },
  // The site bucket: each site's files under <login>/.
  "r2_buckets": [{ "binding": "SITE_FILES", "bucket_name": "naru-pub" }],
  // The custom domain table the control plane sends (src/domains.ts).
  "kv_namespaces": [
    { "binding": "DOMAINS", "id": "11c38b8a51984f708edd9ebf619e3ab3" },
  ],
  // naru.pub itself is DNS-only, straight to the mini (infra
  // cloudflare/dns_naru_pub.tf), so no route here sees it: its data API
  // (/api/data/v1/*, which older SDK files call) is the control plane's own,
  // and naru.pub/sdk/* is a 404 there. The Data SDK and its data API are
  // sdk.naru.pub's, also DNS-only, served by workerd on the mini
  // (wrangler.seoul.jsonc); this Worker serves neither.
  "routes": [
    // The control plane calls /v1/sites/* and /v1/pageviews/* here.
    { "pattern": "edge.naru.pub", "custom_domain": true },
    // Hosted sites. r2.naru.pub and media.naru.pub, the bucket's public
    // domains, are kept off this by more specific routes without a Worker,
    // set up once outside this file (docs/deployment.md).
    { "pattern": "*.naru.pub/*", "zone_name": "naru.pub" },
    // Custom domains reach the zone under their own hostnames through
    // Cloudflare for SaaS, so only a route on every host catches them.
    // naru.pub, if it were ever proxied again, is kept off it by a route
    // without a Worker, like r2.naru.pub.
    { "pattern": "*/*", "zone_name": "naru.pub" },
  ],
  // Anonymous requests a site may make each calendar month (UTC), unless the
  // control plane sets its own. See docs/database.md, "Monthly request budget".
  "vars": {
    "SITE_MONTHLY_REQUESTS": "5000000",
    "PLATFORM_DOMAIN": "naru.pub",
    "R2_PUBLIC_DOMAIN": "r2.naru.pub",
    // How long each data center keeps a site file it read from the bucket
    // (src/pages.ts). The control plane purges a file's entry when it changes.
    "SITE_FILE_CACHE_SECONDS": "86400",
    // The mini's own name: probed by the health check, and where routes are
    // rendered (src/standby.ts).
    "SDK_ORIGIN_HOST": "origin.sdk.naru.pub",
    // The control plane's health, also on the mini, probed apart (standby.ts).
    "CONTROL_PLANE_HEALTH_URL": "https://naru.pub/api/health",
  },
  "observability": { "enabled": true },
  // The mini's health check, each minute (src/standby.ts): sdk.naru.pub and
  // naru.pub, each alerted on apart; it changes nothing. Its secret, set with `wrangler secret put`:
  // DISCORD_WEBHOOK. Routes also need SDK_ORIGIN_SECRET.
  "triggers": { "crons": ["* * * * *"] },
  // Local runs: this Worker with every site's database in it, as SiteData
  // objects in wrangler dev's local storage, for tests.
  // Bindings and vars are not inherited, so they are repeated here; keep
  // them in step with the above. Never deployed.
  "env": {
    "local": {
      // The same name, so local storage made before this env is found. Never
      // deploy it (it would replace the Worker above): no routes, no cron.
      "name": "naru-edge",
      "routes": [],
      "triggers": { "crons": [] },
      // index.ts, SiteData and the data API (src/website.ts), which the
      // deployed Worker does not have.
      "main": "src/local.ts",
      "durable_objects": {
        "bindings": [
          { "name": "SITES", "class_name": "SiteData" },
          { "name": "PAGEVIEWS", "class_name": "PageviewLog" },
        ],
      },
      "exports": {
        "SiteData": { "type": "durable-object", "storage": "sqlite" },
        "PageviewLog": { "type": "durable-object", "storage": "sqlite" },
        "Standby": { "type": "durable-object", "storage": "sqlite" },
      },
      "r2_buckets": [{ "binding": "SITE_FILES", "bucket_name": "naru-pub" }],
      "kv_namespaces": [
        { "binding": "DOMAINS", "id": "11c38b8a51984f708edd9ebf619e3ab3" },
      ],
      // No SDK_ORIGIN_HOST and no STANDBY: routes render here, from SITES.
      "vars": {
        "SITE_MONTHLY_REQUESTS": "5000000",
        "PLATFORM_DOMAIN": "naru.pub",
        "R2_PUBLIC_DOMAIN": "r2.naru.pub",
        "SITE_FILE_CACHE_SECONDS": "86400",
      },
    },
  },
}
