{
  "dialect": "postgres",
  "outFile": "src/lib/db.d.ts",
  "excludePattern": "{kysely_*,fedify_*}",
  "typeMapping": {
    "jsonb": "unknown",
    "interval": "unknown"
  },
  "overrides": {
    "columns": {
      "board_posts.kind": "\"site\" | \"template\" | \"question\" | \"chat\"",
      "board_templates.license": "\"cc0-1.0\" | \"unlicense\" | \"0bsd\" | \"cc-by-4.0\" | \"mit\" | \"apache-2.0\" | \"bsd-2-clause\" | \"bsd-3-clause\" | \"isc\" | \"zlib\" | \"cc-by-sa-4.0\" | \"mpl-2.0\" | \"lgpl-3.0-or-later\" | \"gpl-2.0-or-later\" | \"gpl-3.0-or-later\" | \"agpl-3.0-or-later\" | \"eupl-1.2\" | \"ofl-1.1\"",
      "board_notifications.reason": "\"reply_to_post\" | \"reply_to_reply\"",
      "cron_jobs.process": "\"cron\" | \"worker\"",
      "site_request_overrides.mode": "\"block\" | \"exempt\"",
      "card_registrations.kind": "\"signup\" | \"card_change\"",
      "card_registrations.billing_interval": "\"month\" | \"year\" | null",
      "subscriptions.status": "import(\"./payments/payment-states\").SubscriptionStatus",
      "payments.status": "import(\"./payments/payment-states\").PaymentStatus",
      "toss_window_outcomes.window": "\"billing_auth\" | \"payment\"",
      "payment_transactions.kind": "\"approval\" | \"cancel\"",
      "billing_keys.status": "ColumnType<\"active\" | \"retired\" | \"deleted\", \"active\" | \"retired\" | \"deleted\" | undefined>",
      "board_replies.path": "ColumnType<string[], never, never>",
      "board_template_versions.data_collections": "ColumnType<import(\"./board/template-collections\").BoardTemplateCollection[], string | undefined, string>",
      "subscriptions.billing_key_required_status": "ColumnType<\"active\", never, never>",
      "entitlement_repairs.status": "ColumnType<\"pending\" | \"completed\" | \"skipped\", \"pending\" | \"completed\" | \"skipped\" | undefined>",
      "users.site_data_bytes_used": "ColumnType<string, never, number>",
      "users.site_data_document_count": "ColumnType<string, never, number>",
      "users.site_member_admission": "ColumnType<\"open\" | \"approval\" | \"closed\", \"open\" | \"approval\" | \"closed\" | undefined>",
      "github_deployments.functions_status": "\"activating\" | \"active\" | \"refused\" | null",
      "github_deployments.functions_error": "ColumnType<{ message: string; details?: unknown } | null, string | null, string | null>",
      "site_members.status": "ColumnType<\"pending\" | \"approved\" | \"banned\", \"pending\" | \"approved\" | \"banned\" | undefined>"
    }
  }
}
