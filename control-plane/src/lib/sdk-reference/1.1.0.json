{
  "version": "1.1.0",
  "entries": [
    {
      "name": "createNaru",
      "kind": "function",
      "summary": [
        {
          "type": "paragraph",
          "spans": [
            {
              "type": "text",
              "value": "Creates a client bound to one site."
            }
          ]
        }
      ],
      "throws": [],
      "signature": "createNaru(options?: { site?: string }): NaruClient",
      "parameters": [
        {
          "name": "options",
          "type": "{ site?: string }",
          "summary": [],
          "throws": []
        }
      ]
    },
    {
      "name": "Admin",
      "kind": "interface",
      "summary": [],
      "throws": [],
      "signature": "interface Admin",
      "extends": [],
      "members": [
        {
          "name": "media",
          "optional": false,
          "signature": "media: {\n  delete(id: string, options?: { signal?: AbortSignal }): Promise<void>;\n  upload(\n    file: Blob | File,\n    options?: {\n      managed?: boolean;\n      onProgress?: (\n        progress:\n          | { phase: \"preparing\" }\n          | { loaded: number; phase: \"uploading\"; total: number }\n          | { phase: \"finishing\" },\n      ) => void;\n      signal?: AbortSignal;\n    },\n  ): Promise<{\n    contentType: string;\n    id: string;\n    name: string;\n    size: number;\n    url: string;\n  }>;\n}",
          "summary": [],
          "throws": []
        },
        {
          "name": "batch",
          "optional": false,
          "signature": "batch(\n  writes: readonly (\n    | {\n        collection: string;\n        set: { condition?: WriteCondition; data: unknown; id: string };\n      }\n    | {\n        collection: string;\n        delete: { condition?: { revision: Revision }; id: string };\n      }\n  )[],\n  options?: { signal?: AbortSignal },\n): Promise<\n  ({\n    createdAt: string;\n    id: string;\n    revision: Revision;\n    updatedAt: string;\n  } | null)[]\n>",
          "summary": [
            {
              "type": "paragraph",
              "spans": [
                {
                  "type": "text",
                  "value": "Commits every write or none. Conditions guard individual documents. Does not retry. Resolves, in the order written, with what each "
                },
                {
                  "type": "code",
                  "value": "set"
                },
                {
                  "type": "text",
                  "value": " stored and "
                },
                {
                  "type": "code",
                  "value": "null"
                },
                {
                  "type": "text",
                  "value": " for each "
                },
                {
                  "type": "code",
                  "value": "delete"
                },
                {
                  "type": "text",
                  "value": "."
                }
              ]
            }
          ],
          "throws": []
        },
        {
          "name": "call",
          "optional": false,
          "signature": "call<R = Json>(\n  name: string,\n  args?: Json,\n  options?: { signal?: AbortSignal },\n): Promise<R>",
          "summary": [
            {
              "type": "paragraph",
              "spans": [
                {
                  "type": "text",
                  "value": "Calls one of the site's functions as the owner, as "
                },
                {
                  "type": "code",
                  "value": "Member.call"
                },
                {
                  "type": "text",
                  "value": " does for a member: the function sees "
                },
                {
                  "type": "code",
                  "value": "ctx.member"
                },
                {
                  "type": "text",
                  "value": " null and "
                },
                {
                  "type": "code",
                  "value": "ctx.owner"
                },
                {
                  "type": "text",
                  "value": " true, whatever collections this sign-in approved. Owner calls are not counted against the site's budget."
                }
              ]
            }
          ],
          "throws": []
        },
        {
          "name": "collection",
          "optional": false,
          "signature": "collection<T = Json>(name: string): Collection<T>",
          "summary": [],
          "throws": []
        },
        {
          "name": "signOut",
          "optional": false,
          "signature": "signOut(): Promise<void>",
          "summary": [
            {
              "type": "paragraph",
              "spans": [
                {
                  "type": "text",
                  "value": "This handle stops working at once, even if the revoke request fails."
                }
              ]
            }
          ],
          "throws": []
        }
      ]
    },
    {
      "name": "Collection",
      "kind": "interface",
      "summary": [
        {
          "type": "paragraph",
          "spans": [
            {
              "type": "text",
              "value": "A handle on one collection, the same for a visitor, a member and the owner: what each may do, the collection's permissions and rules decide on Naru."
            }
          ]
        }
      ],
      "throws": [],
      "signature": "interface Collection<T = Json>",
      "extends": [],
      "members": [
        {
          "name": "add",
          "optional": false,
          "signature": "add(\n  data: T,\n  options?: { secret?: string; signal?: AbortSignal },\n): Promise<Document<T>>",
          "summary": [
            {
              "type": "paragraph",
              "spans": [
                {
                  "type": "code",
                  "value": "secret"
                },
                {
                  "type": "text",
                  "value": " (1.1.0): whoever later gives the same secret may replace or delete the document, as a guest's password lets them edit a post. Naru keeps only a hash and never returns it."
                }
              ]
            }
          ],
          "throws": []
        },
        {
          "name": "count",
          "optional": false,
          "signature": "count(options?: {\n  filter?: Filter;\n  signal?: AbortSignal;\n  where?: Predicate;\n}): Promise<number>",
          "summary": [
            {
              "type": "paragraph",
              "spans": [
                {
                  "type": "text",
                  "value": "How many documents match "
                },
                {
                  "type": "code",
                  "value": "filter"
                },
                {
                  "type": "text",
                  "value": " and "
                },
                {
                  "type": "code",
                  "value": "where"
                },
                {
                  "type": "text",
                  "value": ", or the whole collection."
                }
              ]
            }
          ],
          "throws": []
        },
        {
          "name": "delete",
          "optional": false,
          "signature": "delete(\n  id: string,\n  options?: {\n    condition?: { revision: Revision };\n    secret?: string;\n    signal?: AbortSignal;\n  },\n): Promise<void>",
          "summary": [
            {
              "type": "paragraph",
              "spans": [
                {
                  "type": "text",
                  "value": "Deletes a document, as "
                },
                {
                  "type": "code",
                  "value": "set"
                },
                {
                  "type": "text",
                  "value": " may replace it. Deleting a missing document succeeds unless a condition was supplied."
                }
              ]
            }
          ],
          "throws": []
        },
        {
          "name": "get",
          "optional": false,
          "signature": "get(id: string, options?: { signal?: AbortSignal }): Promise<Document<T>>",
          "summary": [],
          "throws": []
        },
        {
          "name": "getMany",
          "optional": false,
          "signature": "getMany(\n  ids: readonly string[],\n  options?: { signal?: AbortSignal },\n): Promise<(Document<T> | null)[]>",
          "summary": [
            {
              "type": "paragraph",
              "spans": [
                {
                  "type": "text",
                  "value": "One bounded read, in input order; missing or unreadable rows are null."
                }
              ]
            }
          ],
          "throws": []
        },
        {
          "name": "list",
          "optional": false,
          "signature": "list(options?: ListOptions): Promise<Page<T>>",
          "summary": [],
          "throws": []
        },
        {
          "name": "pages",
          "optional": false,
          "signature": "pages(options?: ListOptions): AsyncIterable<Page<T>>",
          "summary": [
            {
              "type": "paragraph",
              "spans": [
                {
                  "type": "text",
                  "value": "Every page of a query in turn, following "
                },
                {
                  "type": "code",
                  "value": "nextCursor"
                },
                {
                  "type": "text",
                  "value": " from "
                },
                {
                  "type": "code",
                  "value": "after"
                },
                {
                  "type": "text",
                  "value": " (or the start). Not a snapshot: writes in between can shift later pages."
                }
              ]
            }
          ],
          "throws": []
        },
        {
          "name": "set",
          "optional": false,
          "signature": "set(\n  id: string,\n  data: T,\n  options?: {\n    condition?: WriteCondition;\n    secret?: string;\n    signal?: AbortSignal;\n  },\n): Promise<Document<T>>",
          "summary": [
            {
              "type": "paragraph",
              "spans": [
                {
                  "type": "text",
                  "value": "Replaces the whole document, or creates it, when the collection or its rule allows: the owner always; a member, a document they created or the one named by their own "
                },
                {
                  "type": "code",
                  "value": "member.id"
                },
                {
                  "type": "text",
                  "value": "; a guest, with the secret it was added with (1.1.0)."
                }
              ]
            }
          ],
          "throws": []
        }
      ]
    },
