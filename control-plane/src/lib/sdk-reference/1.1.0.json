    {
      "name": "createNaru",
      "kind": "function",
      "summary": [
        {
          "type": "paragraph",
          "spans": [
            {
              "type": "text",
              "value": "Creates a client bound to one site."
            }
          ]
        }
      ],
      "throws": [],
      "signature": "createNaru(options?: { site?: string }): NaruClient",
      "parameters": [
        {
          "name": "options",
          "type": "{ site?: string }",
          "summary": [],
          "throws": []
        }
      ]
    },
    {
      "name": "Admin",
      "kind": "interface",
      "summary": [
        {
          "type": "paragraph",
          "spans": [
            {
              "type": "text",
              "value": "The owner signed in on this page. Its queries and mutations see "
            },
            {
              "type": "code",
              "value": "ctx.member"
            },
            {
              "type": "text",
              "value": " null and "
            },
            {
              "type": "code",
              "value": "ctx.owner"
            },
            {
              "type": "text",
              "value": " true, whatever collections this sign-in approved, and are not counted against the site's budget."
            }
          ]
        }
      ],
      "throws": [],
      "signature": "interface Admin extends SiteCode, LiveQueries",
      "extends": [
        "SiteCode",
        "LiveQueries"
      ],
      "members": [
        {
          "name": "media",
          "optional": false,
          "signature": "media: {\n  delete(id: string, options?: { signal?: AbortSignal }): Promise<void>;\n  upload(\n    file: Blob | File,\n    options?: {\n      onProgress?: (\n        progress:\n          | { phase: \"preparing\" }\n          | { loaded: number; phase: \"uploading\"; total: number }\n          | { phase: \"finishing\" },\n      ) => void;\n      signal?: AbortSignal;\n    },\n  ): Promise<{\n    contentType: string;\n    id: string;\n    name: string;\n    size: number;\n    url: string;\n  }>;\n}",
          "summary": [],
          "throws": []
        },
        {
          "name": "batch",
          "optional": false,
          "signature": "batch(\n  writes: readonly (\n    | {\n        collection: string;\n        set: { condition?: WriteCondition; data: unknown; id: string };\n      }\n    | {\n        collection: string;\n        delete: { condition?: { revision: Revision }; id: string };\n      }\n  )[],\n  options?: { signal?: AbortSignal },\n): Promise<\n  ({\n    createdAt: string;\n    id: string;\n    revision: Revision;\n    updatedAt: string;\n  } | null)[]\n>",
          "summary": [
            {
              "type": "paragraph",
              "spans": [
                {
                  "type": "text",
                  "value": "Commits every write or none. Conditions guard individual documents. Does not retry. Resolves, in the order written, with what each "
                },
                {
                  "type": "code",
                  "value": "set"
                },
                {
                  "type": "text",
                  "value": " stored and "
                },
                {
                  "type": "code",
                  "value": "null"
                },
                {
                  "type": "text",
                  "value": " for each "
                },
                {
                  "type": "code",
                  "value": "delete"
                },
                {
                  "type": "text",
                  "value": "."
                }
              ]
            }
          ],
          "throws": []
        },
        {
          "name": "collection",
          "optional": false,
          "signature": "collection<T = Json>(name: string): AdminCollection<T>",
          "summary": [],
          "throws": []
        },
        {
          "name": "signOut",
          "optional": false,
          "signature": "signOut(): Promise<void>",
          "summary": [
            {
              "type": "paragraph",
              "spans": [
                {
                  "type": "text",
                  "value": "This handle stops working at once, even if the revoke request fails."
                }
              ]
            }
          ],
          "throws": []
        }
      ]
    },
