    {
      "name": "Live",
      "kind": "interface",
      "summary": [
        {
          "type": "paragraph",
          "spans": [
            {
              "type": "text",
              "value": "A live connection, reconnecting by itself until closed."
            }
          ]
        }
      ],
      "throws": [],
      "signature": "interface Live",
      "extends": [],
      "members": [
        {
          "name": "close",
          "optional": false,
          "signature": "close(): void",
          "summary": [],
          "throws": []
        }
      ]
    },
    {
      "name": "LiveOptions",
      "kind": "interface",
      "summary": [],
      "throws": [],
      "signature": "interface LiveOptions",
      "extends": [],
      "members": [
        {
          "name": "topics",
          "optional": true,
          "signature": "topics?: readonly string[]",
          "summary": [
            {
              "type": "paragraph",
              "spans": [
                {
                  "type": "text",
                  "value": "Up to eight topic names whose broadcasts to hear."
                }
              ]
            }
          ],
          "throws": []
        },
        {
          "name": "onMessage",
          "optional": false,
          "signature": "onMessage(message: LiveMessage): void",
          "summary": [],
          "throws": []
        },
        {
          "name": "onStatus",
          "optional": true,
          "signature": "onStatus(status: \"closed\" | \"connecting\" | \"open\" | \"reconnecting\"): void",
          "summary": [
            {
              "type": "paragraph",
              "spans": [
                {
                  "type": "text",
                  "value": "Called as the connection opens, drops and reconnects, and once it is closed for good: by "
                },
                {
                  "type": "code",
                  "value": "close()"
                },
                {
                  "type": "text",
                  "value": ", or because the member's access ended. Messages sent while it was down are not delivered later, so read again on "
                },
                {
                  "type": "code",
                  "value": "open"
                },
                {
                  "type": "text",
                  "value": " if they matter."
                }
              ]
            }
          ],
          "throws": []
        }
      ]
    },
    {
      "name": "Member",
      "kind": "interface",
      "summary": [
        {
          "type": "paragraph",
          "spans": [
            {
              "type": "text",
              "value": "A visitor signed in to this site with their Naru account."
            }
          ]
        }
      ],
      "throws": [],
      "signature": "interface Member",
      "extends": [],
      "members": [
        {
          "name": "id",
          "optional": false,
          "signature": "id: string",
          "summary": [
            {
              "type": "paragraph",
              "spans": [
                {
                  "type": "text",
                  "value": "This member's ID on this site, the same on every visit. Documents they create carry it as "
                },
                {
                  "type": "code",
                  "value": "createdBy"
                },
                {
                  "type": "text",
                  "value": ". It is not their Naru account name."
                }
              ]
            }
          ],
          "throws": []
        },
        {
          "name": "media",
          "optional": false,
          "signature": "media: {\n  delete(id: string, options?: { signal?: AbortSignal }): Promise<void>;\n  upload(\n    file: Blob | File,\n    options?: {\n      managed?: boolean;\n      onProgress?: (\n        progress:\n          | { phase: \"preparing\" }\n          | { loaded: number; phase: \"uploading\"; total: number }\n          | { phase: \"finishing\" },\n      ) => void;\n      signal?: AbortSignal;\n    },\n  ): Promise<{\n    contentType: string;\n    id: string;\n    name: string;\n    size: number;\n    url: string;\n  }>;\n}",
          "summary": [],
          "throws": []
        },
        {
          "name": "call",
          "optional": false,
          "signature": "call<R = Json>(\n  name: string,\n  args?: Json,\n  options?: { signal?: AbortSignal },\n): Promise<R>",
          "summary": [
            {
              "type": "paragraph",
              "spans": [
                {
                  "type": "text",
                  "value": "Calls one of the site's functions, "
                },
                {
                  "type": "code",
                  "value": "\"<module/path>:<function>\""
                },
                {
                  "type": "text",
                  "value": ": an export of the site's "
                },
                {
                  "type": "code",
                  "value": "_naru/functions/<module/path>.js"
                },
                {
                  "type": "text",
                  "value": ". It runs on Naru, in one transaction, with the site owner's access to its collections, and resolves with what it returned. A function that throws, or exceeds its limits, changes nothing. Exports the module lists in "
                },
                {
                  "type": "code",
                  "value": "export const readOnly = [...]"
                },
                {
                  "type": "text",
                  "value": " cannot write, and count against the member's read budget instead of their calls. Static relative JavaScript imports and re-exports may share code in "
                },
                {
                  "type": "code",
                  "value": "_naru/modules/"
                },
                {
                  "type": "text",
                  "value": "; imports stay within "
                },
                {
                  "type": "code",
                  "value": "_naru/functions/"
                },
                {
                  "type": "text",
                  "value": " and "
                },
                {
                  "type": "code",
                  "value": "_naru/modules/"
                },
                {
                  "type": "text",
                  "value": ". Include "
                },
                {
                  "type": "code",
                  "value": ".js"
                },
                {
                  "type": "text",
                  "value": "; dynamic imports and top-level await are unsupported. File updates activate an immutable source revision."
                }
              ]
            }
          ],
          "throws": []
        },
        {
          "name": "collection",
          "optional": false,
          "signature": "collection<T = Json>(name: string): Collection<T>",
          "summary": [],
          "throws": []
        },
        {
          "name": "live",
          "optional": false,
          "signature": "live(options: LiveOptions): Live",
          "summary": [
            {
              "type": "paragraph",
              "spans": [
                {
                  "type": "text",
                  "value": "Hears what the site's functions send this member ("
                },
                {
                  "type": "code",
                  "value": "ctx.notify"
                },
                {
                  "type": "text",
                  "value": "), and broadcasts to "
                },
                {
                  "type": "code",
                  "value": "topics"
                },
                {
                  "type": "text",
                  "value": ", until closed or until their access ends."
                }
              ]
            }
          ],
          "throws": []
        },
        {
          "name": "signOut",
          "optional": false,
          "signature": "signOut(): Promise<void>",
          "summary": [
            {
              "type": "paragraph",
              "spans": [
                {
                  "type": "text",
                  "value": "Signs out on every page of this site. This handle stops working at once, even if the revoke request fails."
                }
              ]
            }
          ],
          "throws": []
        }
      ]
    },
    {
      "name": "NaruClient",
      "kind": "interface",
      "summary": [],
      "throws": [],
      "signature": "interface NaruClient",
      "extends": [],
      "members": [
        {
          "name": "auth",
          "optional": false,
          "signature": "auth: {\n  session(): Promise<Admin | null>;\n  signIn(options: {\n    collections: readonly string[];\n    mediaDelete?: boolean;\n  }): Promise<void>;\n}",
          "summary": [],
          "throws": []
        },
        {
          "name": "members",
          "optional": false,
          "signature": "members: { session(): Promise<Member | null>; signIn(): Promise<void> }",
          "summary": [],
          "throws": []
        },
        {
          "name": "call",
          "optional": false,
          "signature": "call<R = Json>(\n  name: string,\n  args?: Json,\n  options?: { signal?: AbortSignal },\n): Promise<R>",
          "summary": [
            {
              "type": "paragraph",
              "spans": [
                {
                  "type": "text",
                  "value": "Calls a site function as a visitor, signed in to nothing: only exports the module lists in "
                },
                {
                  "type": "code",
                  "value": "export const visitors = [...]"
                },
                {
                  "type": "text",
                  "value": "; others fail with "
                },
                {
                  "type": "code",
                  "value": "AUTH_REQUIRED"
                },
                {
                  "type": "text",
                  "value": ". The function sees "
                },
                {
                  "type": "code",
                  "value": "ctx.visitor"
                },
                {
                  "type": "text",
                  "value": " true and "
                },
                {
                  "type": "code",
                  "value": "ctx.member"
                },
                {
                  "type": "text",
                  "value": " null. Calls are limited per visitor address and count against the site's budget."
                }
              ]
            }
          ],
          "throws": []
        },
        {
          "name": "collection",
          "optional": false,
          "signature": "collection<T = Json>(name: string): Collection<T>",
          "summary": [
            {
              "type": "paragraph",
              "spans": [
                {
                  "type": "text",
                  "value": "Visitor access, even when signed in."
                }
              ]
            }
          ],
          "throws": []
        },
        {
          "name": "live",
          "optional": false,
          "signature": "live(options: LiveOptions): Live",
          "summary": [
            {
              "type": "paragraph",
              "spans": [
                {
                  "type": "text",
                  "value": "Hears what the site's functions broadcast to "
                },
                {
                  "type": "code",
                  "value": "topics"
                },
                {
                  "type": "text",
                  "value": ", as anyone may: broadcasts are public. Connecting counts against the site's budget."
                }
              ]
            }
          ],
          "throws": []
        }
      ]
    },
    {
      "name": "Page",
      "kind": "interface",
      "summary": [],
      "throws": [],
      "signature": "interface Page<T = Json>",
      "extends": [],
      "members": [
        {
          "name": "documents",
          "optional": false,
          "signature": "documents: Document<T>[]",
          "summary": [],
          "throws": []
        },
        {
          "name": "nextCursor",
          "optional": false,
          "signature": "nextCursor: string | null",
          "summary": [],
          "throws": []
        },
        {
          "name": "totalCount",
          "optional": true,
          "signature": "totalCount?: number",
          "summary": [],
          "throws": []
        }
      ]
    },
    {
      "name": "NaruError",
      "kind": "class",
      "summary": [
        {
          "type": "paragraph",
          "spans": [
            {
              "type": "text",
              "value": "A Naru operation that could not be completed. Check it with "
            },
            {
              "type": "code",
              "value": "instanceof"
            },
            {
              "type": "text",
              "value": "."
            }
          ]
        },
        {
          "type": "paragraph",
          "spans": [
            {
              "type": "code",
              "value": "message"
            },
            {
              "type": "text",
              "value": " is a short Korean sentence a visitor can read, so a page may show it as is ("
            },
            {
              "type": "code",
              "value": "status.textContent = error.message"
            },
            {
              "type": "text",
              "value": "): a site function's own "
            },
            {
              "type": "code",
              "value": "ctx.fail"
            },
            {
              "type": "text",
              "value": " message, or Naru's wording for "
            },
            {
