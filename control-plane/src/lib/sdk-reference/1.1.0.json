    {
      "name": "Live",
      "kind": "interface",
      "summary": [
        {
          "type": "paragraph",
          "spans": [
            {
              "type": "text",
              "value": "A live query, kept current until closed."
            }
          ]
        }
      ],
      "throws": [],
      "signature": "interface Live",
      "extends": [],
      "members": [
        {
          "name": "close",
          "optional": false,
          "signature": "close(): void",
          "summary": [],
          "throws": []
        }
      ]
    },
    {
      "name": "LiveQueries",
      "kind": "interface",
      "summary": [
        {
          "type": "paragraph",
          "spans": [
            {
              "type": "text",
              "value": "Live queries: a query's answer, kept current."
            }
          ]
        }
      ],
      "throws": [],
      "signature": "interface LiveQueries",
      "extends": [],
      "members": [
        {
          "name": "subscribe",
          "optional": false,
          "signature": "subscribe<R = Json>(\n  name: string,\n  args: Json,\n  onResult: (result: R) => void,\n  options?: { onError(error: NaruError): void },\n): Live",
          "summary": [
            {
              "type": "paragraph",
              "spans": [
                {
                  "type": "text",
                  "value": "Runs "
                },
                {
                  "type": "code",
                  "value": "\"<module/path>:<query>\""
                },
                {
                  "type": "text",
                  "value": " from the site's "
                },
                {
                  "type": "code",
                  "value": "_naru/queries/"
                },
                {
                  "type": "text",
                  "value": " as "
                },
                {
                  "type": "code",
                  "value": "query()"
                },
                {
                  "type": "text",
                  "value": " does, calls "
                },
                {
                  "type": "code",
                  "value": "onResult"
                },
                {
                  "type": "text",
                  "value": " with its answer, and again whenever a write changes a table it read and the answer with it, until closed. After the connection drops it is asked again, so the latest answer arrives once it is back. A failure, now or later, goes to "
                },
                {
                  "type": "code",
                  "value": "onError"
                },
                {
                  "type": "text",
                  "value": ". A connection holds at most 20."
                }
              ]
            }
          ],
          "throws": []
        }
      ]
    },
    {
      "name": "Member",
      "kind": "interface",
      "summary": [
        {
          "type": "paragraph",
          "spans": [
            {
              "type": "text",
              "value": "A visitor signed in to this site with their Naru account."
            }
          ]
        }
      ],
      "throws": [],
      "signature": "interface Member extends SiteCode, LiveQueries",
      "extends": [
        "SiteCode",
        "LiveQueries"
      ],
      "members": [
        {
          "name": "id",
          "optional": false,
          "signature": "id: string",
          "summary": [
            {
              "type": "paragraph",
              "spans": [
                {
                  "type": "text",
                  "value": "This member's ID on this site, the same on every visit: "
                },
                {
                  "type": "code",
                  "value": "ctx.member.id"
                },
                {
                  "type": "text",
                  "value": " in the site's queries and mutations. It is not their Naru account name."
                }
              ]
            }
          ],
          "throws": []
        },
        {
          "name": "media",
          "optional": false,
          "signature": "media: {\n  delete(id: string, options?: { signal?: AbortSignal }): Promise<void>;\n  upload(\n    file: Blob | File,\n    options?: {\n      onProgress?: (\n        progress:\n          | { phase: \"preparing\" }\n          | { loaded: number; phase: \"uploading\"; total: number }\n          | { phase: \"finishing\" },\n      ) => void;\n      signal?: AbortSignal;\n    },\n  ): Promise<{\n    contentType: string;\n    id: string;\n    name: string;\n    size: number;\n    url: string;\n  }>;\n}",
          "summary": [],
          "throws": []
        },
        {
          "name": "signOut",
          "optional": false,
          "signature": "signOut(): Promise<void>",
          "summary": [
            {
              "type": "paragraph",
              "spans": [
                {
                  "type": "text",
                  "value": "Signs out on every page of this site. This handle stops working at once, even if the revoke request fails."
                }
              ]
            }
          ],
          "throws": []
        }
      ]
    },
    {
      "name": "NaruClient",
      "kind": "interface",
      "summary": [
        {
          "type": "paragraph",
          "spans": [
            {
              "type": "text",
              "value": "A page's client. Its queries and mutations run as a visitor, signed in to nothing: they see "
            },
            {
              "type": "code",
              "value": "ctx.visitor"
            },
            {
              "type": "text",
              "value": " true and "
            },
            {
              "type": "code",
              "value": "ctx.member"
            },
            {
              "type": "text",
              "value": " null, are limited per visitor address, and count against the site's budget."
            }
          ]
        }
      ],
      "throws": [],
      "signature": "interface NaruClient extends SiteCode, LiveQueries",
      "extends": [
        "SiteCode",
        "LiveQueries"
      ],
      "members": [
        {
          "name": "auth",
          "optional": false,
          "signature": "auth: {\n  session(): Promise<Admin | null>;\n  signIn(options?: {\n    collections?: readonly string[];\n    mediaDelete?: boolean;\n  }): Promise<void>;\n}",
          "summary": [],
          "throws": []
        },
        {
          "name": "members",
          "optional": false,
          "signature": "members: { session(): Promise<Member | null>; signIn(): Promise<void> }",
          "summary": [],
          "throws": []
        },
        {
          "name": "collection",
          "optional": false,
          "signature": "collection<T = Json>(name: string): PublicCollection<T>",
          "summary": [
            {
              "type": "paragraph",
              "spans": [
                {
                  "type": "text",
                  "value": "Visitor access, even when signed in."
                }
              ]
            }
          ],
          "throws": []
        }
      ]
    },
    {
      "name": "Page",
      "kind": "interface",
      "summary": [],
      "throws": [],
      "signature": "interface Page<T = Json>",
      "extends": [],
      "members": [
        {
          "name": "documents",
          "optional": false,
          "signature": "documents: Document<T>[]",
          "summary": [],
          "throws": []
        },
        {
          "name": "nextCursor",
          "optional": false,
          "signature": "nextCursor: string | null",
          "summary": [],
          "throws": []
        },
        {
          "name": "totalCount",
          "optional": true,
          "signature": "totalCount?: number",
          "summary": [],
          "throws": []
        }
      ]
    },
    {
      "name": "PublicCollection",
      "kind": "interface",
      "summary": [],
      "throws": [],
      "signature": "interface PublicCollection<T = Json>",
      "extends": [],
      "members": [
        {
          "name": "add",
          "optional": false,
          "signature": "add(data: T, options?: { signal?: AbortSignal }): Promise<Document<T>>",
          "summary": [],
          "throws": []
        },
        {
          "name": "count",
          "optional": false,
          "signature": "count(options?: {\n  filter?: Filter;\n  signal?: AbortSignal;\n}): Promise<number>",
          "summary": [
            {
              "type": "paragraph",
              "spans": [
                {
                  "type": "text",
                  "value": "How many documents match "
                },
                {
                  "type": "code",
                  "value": "filter"
                },
                {
                  "type": "text",
                  "value": ", or the whole collection."
                }
              ]
            }
          ],
          "throws": []
        },
        {
          "name": "get",
          "optional": false,
          "signature": "get(id: string, options?: { signal?: AbortSignal }): Promise<Document<T>>",
          "summary": [],
          "throws": []
        },
        {
          "name": "list",
          "optional": false,
          "signature": "list(options?: ListOptions): Promise<Page<T>>",
          "summary": [],
          "throws": []
        },
        {
          "name": "pages",
          "optional": false,
          "signature": "pages(options?: ListOptions): AsyncIterable<Page<T>>",
          "summary": [
            {
              "type": "paragraph",
              "spans": [
                {
                  "type": "text",
                  "value": "Every page of a query in turn, following "
                },
                {
                  "type": "code",
                  "value": "nextCursor"
                },
                {
                  "type": "text",
                  "value": " from "
                },
                {
                  "type": "code",
                  "value": "after"
                },
                {
                  "type": "text",
                  "value": " (or the start). Not a snapshot: writes in between can shift later pages."
                }
              ]
            }
          ],
          "throws": []
        }
      ]
    },
    {
      "name": "SiteCode",
      "kind": "interface",
      "summary": [
        {
          "type": "paragraph",
          "spans": [
            {
              "type": "text",
              "value": "The site's queries and mutations: its own code over its own tables, which its "
            },
            {
              "type": "code",
              "value": "_naru/migrations/"
            },
            {
              "type": "text",
              "value": " create. Anyone may call them, signed in or not; the code decides what each caller may see and do from "
            },
            {
              "type": "code",
              "value": "ctx.member"
            },
            {
              "type": "text",
              "value": ", "
            },
            {
              "type": "code",
              "value": "ctx.owner"
            },
            {
              "type": "text",
              "value": " and "
            },
            {
              "type": "code",
              "value": "ctx.visitor"
            },
            {
              "type": "text",
              "value": "."
            }
          ]
        }
      ],
      "throws": [],
      "signature": "interface SiteCode",
      "extends": [],
      "members": [
        {
          "name": "mutate",
          "optional": false,
          "signature": "mutate<R = Json>(\n  name: string,\n  args?: Json,\n  options?: { signal?: AbortSignal },\n): Promise<R>",
          "summary": [
            {
              "type": "paragraph",
              "spans": [
                {
                  "type": "text",
                  "value": "Runs an export of "
                },
                {
                  "type": "code",
                  "value": "_naru/mutations/<module/path>.js"
                },
                {
                  "type": "text",
                  "value": " in one transaction: what it wrote is kept only if it returns, and a throw, "
                },
                {
                  "type": "code",
                  "value": "ctx.fail"
                },
                {
                  "type": "text",
                  "value": " or a limit changes nothing."
                }
              ]
            }
          ],
          "throws": []
        },
        {
          "name": "query",
          "optional": false,
          "signature": "query<R = Json>(\n  name: string,\n  args?: Json,\n  options?: { signal?: AbortSignal },\n): Promise<R>",
          "summary": [
            {
              "type": "paragraph",
              "spans": [
                {
                  "type": "text",
                  "value": "Runs "
                },
                {
                  "type": "code",
                  "value": "\"<module/path>:<name>\""
                },
                {
                  "type": "text",
                  "value": ", an export of the site's "
                },
                {
                  "type": "code",
                  "value": "_naru/queries/<module/path>.js"
                },
                {
                  "type": "text",
                  "value": ", and resolves with what it returned. A query only reads ("
                },
                {
                  "type": "code",
                  "value": "ctx.sql"
                },
                {
                  "type": "text",
                  "value": "), so it counts against the caller's read budget."
                }
              ]
            }
          ],
          "throws": []
        }
      ]
    },
    {
      "name": "NaruError",
      "kind": "class",
      "summary": [
        {
          "type": "paragraph",
          "spans": [
            {
              "type": "text",
              "value": "A Naru operation that could not be completed. Check it with "
            },
            {
              "type": "code",
              "value": "instanceof"
            },
            {
              "type": "text",
              "value": "."
            }
          ]
        },
        {
          "type": "paragraph",
          "spans": [
            {
              "type": "code",
              "value": "message"
            },
            {
              "type": "text",
              "value": " is a short Korean sentence a visitor can read, so a page may show it as is ("
            },
            {
              "type": "code",
              "value": "status.textContent = error.message"
            },
            {
              "type": "text",
              "value": "): a query's or mutation's own "
            },
            {
              "type": "code",
              "value": "ctx.fail"
            },
            {
              "type": "text",
              "value": " message, or Naru's wording for "
            },
            {
              "type": "code",
              "value": "code"
            },
            {
              "type": "text",
              "value": ". Naru's English account of what went wrong, for developers, is "
            },
            {
              "type": "code",
              "value": "error.cause.message"
            },
            {
              "type": "text",
              "value": "."
            }
          ]
        }
      ],
      "throws": [],
      "signature": "class NaruError extends Error",
      "extends": [
        "Error"
      ],
      "members": [
        {
          "name": "code",
          "optional": false,
          "signature": "code: NaruErrorCode",
          "summary": [],
          "throws": []
        },
        {
          "name": "details",
          "optional": true,
          "signature": "details?: Json",
          "summary": [
            {
              "type": "paragraph",
              "spans": [
                {
                  "type": "text",
                  "value": "The JSON a query or mutation passed as "
                },
                {
                  "type": "code",
                  "value": "ctx.fail(code, message, details)"
                },
                {
                  "type": "text",
                  "value": ", such as "
                },
                {
                  "type": "code",
                  "value": "{ reason: \"sold_out\" }"
                },
                {
                  "type": "text",
                  "value": "; or, when a member's request is refused because the site has not approved them, "
                },
                {
                  "type": "code",
                  "value": "{ membership: \"pending\" }"
                },
                {
                  "type": "text",
                  "value": " or "
                },
                {
                  "type": "code",
                  "value": "{ membership: \"banned\" }"
                },
                {
                  "type": "text",
                  "value": "; or, for a "
                },
                {
                  "type": "code",
                  "value": "CONFLICT"
                },
                {
                  "type": "text",
                  "value": " because another document already holds a value of one of the collection's unique fields, "
                },
                {
                  "type": "code",
                  "value": "{ unique: \"<field>\" }"
                },
                {
                  "type": "text",
                  "value": ". Undefined for every other failure."
                }
              ]
            }
          ],
          "throws": []
        }
      ]
    },
    {
      "name": "Filter",
      "kind": "type",
      "summary": [
        {
          "type": "paragraph",
          "spans": [
            {
              "type": "text",
              "value": "Top-level user fields, combined with AND."
            }
          ]
        }
      ],
      "throws": [],
      "signature": "type Filter = Record<\n  string,\n  | string\n  | number\n  | boolean\n  | null\n  | {\n      gt?: string | number;\n      gte?: string | number;\n      lt?: string | number;\n      lte?: string | number;\n    }\n>"
    },
    {
      "name": "Json",
      "kind": "type",
      "summary": [],
      "throws": [],
      "signature": "type Json =\n  null | boolean | number | string | Json[] | { [key: string]: Json }"
    },
    {
      "name": "NaruErrorCode",
      "kind": "type",
      "summary": [
        {
          "type": "paragraph",
          "spans": [
            {
              "type": "text",
              "value": "Why an operation failed. The list is closed for v1: a code a later server adds reaches this version as the nearest code here."
            }
          ]
        }
